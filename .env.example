# Read by docker compose and by deploy/*.yaml through ${...}.

# first approver account, created on the first start only ("admin")
SCEAU_ADMIN_PASSWORD=
# shared with `sceau wrap` when the wrapper does not run on the proxy's host
SCEAU_RELAY_TOKEN=
# the address approvers use to reach the console (links in Slack)
SCEAU_PUBLIC_URL=http://localhost:7325
SCEAU_LISTEN=127.0.0.1:7325
SCEAU_DATA=./data

# Slack: a bot with chat:write posts holds with Seal / Decline buttons;
# set its interactivity URL to <SCEAU_PUBLIC_URL>/slack/actions
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=
# or only a link to the console, through an incoming webhook
SLACK_WEBHOOK_URL=
# any other system: every hold POSTed as JSON
APPROVALS_WEBHOOK=

# demo only: where the demo tool servers listen
DEMO_TOOLS=http://127.0.0.1:8400
